VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_WHATSAPP_API_URL=your-whatsapp-pterodactyl-url
VITE_WHATSAPP_TOKEN=your-whatsapp-api-token

# service role key (RAHASIA, cuma server) — buat /api/create-user bikin akun pemilik.
# JANGAN kasih prefix VITE_ (biar gak ke-bundle/bocor ke browser).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare Turnstile CAPTCHA Keys
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
SUPABASE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Owner Configuration for WhatsApp Bot LID mapping
OWNER_NUMBER=your-owner-number
OWNER_LID=your-owner-lid

